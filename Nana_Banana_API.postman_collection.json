	"item": [
		{
			"name": "Telemetry & Logs",
			"item": [
				{
					"name": "Log Gemini Generation Event",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"sessionId\": \"sess_test_123456\",\n  \"model\": \"gemini-3.1-flash-image\",\n  \"prompt\": \"A premium photograph of a cozy nursery with wild floral wallpaper, natural daylight, Canon EOS R5.\",\n  \"cost\": 0.0504,\n  \"duration\": 11.2,\n  \"status\": \"success\",\n  \"error\": null\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/log-event",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"log-event"
							]
						},
						"description": "Logs a Gemini image generation event. In local development, this appends the details structured by session to `gemini_sessions.json` on disk."
					},
					"response": []
				},
				{
					"name": "Log Generation Error",
